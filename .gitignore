# Editor / agent local state
.claude/
.vscode/

# Conda env exports (machine-local)
conda-env
*.conda-env

# Machine-local config side-channels (paths, machine identity — never commit)
**/config_local.py

# Explicit keeps (negation — these are config, not output)
!**/.gitkeep
!doc/**

# But still block heavy/binary types even under doc/
**/*.pdf
**/*.png
**/*.jpg
**/*.jpeg
