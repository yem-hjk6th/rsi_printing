% Artec Group's foundational multi-frame surface measurement patent.
% Describes capturing multiple images from different perspectives and
% merging them in a common reference frame using a reference object —
% the conceptual ancestor of Artec Studio's fusion pipeline.
% US publication: US20090067706A1 (PCT: WO2009035890A3)
% No journal DOI exists; cite by patent number only.
@misc{artec2009multiframe,
  author       = {Lapa, Nikolay L.},
  title        = {System and Method for Multiframe Surface Measurement of the Shape of Objects},
  howpublished = {Patent WO2009035890A3 / US20090067706A1, Artec Group Inc.},
  year         = {2009},
  note         = {PCT/US2008/075150, filed 2007-09-12, published 2010-08-12. Assignee: Artec Group Inc. Describes multi-image capture and merger into a common reference system — foundational to Artec Studio fusion pipeline. No peer-reviewed DOI; cited from Google Patents.}
}

% -------------------------------------------------------
% SECTION B: Sharp-feature-preserving surface reconstruction
% -------------------------------------------------------

% Seminal method for extracting line-type features on point-sampled geometry
% using PCA on local neighborhoods at multiple scales. The reference work for
% classifying points by feature likelihood — a standard baseline for any
% sharp-feature-aware pipeline including structured-light scanners.
% DOI verified via CrossRef.
@article{pauly2003multiscale,
  author    = {Pauly, Mark and Keiser, Richard and Gross, Markus},
  title     = {Multi-scale Feature Extraction on Point-Sampled Surfaces},
  journal   = {Computer Graphics Forum},
  year      = {2003},
  volume    = {22},
  number    = {3},
  pages     = {281--289},
  doi       = {10.1111/1467-8659.00675},
  note      = {Eurographics 2003. Multi-scale PCA classification of feature points on point clouds; canonical reference for feature-line extraction that precedes volumetric fusion pipelines.}
}

% Robust classification of mesh edges and vertices as sharp/smooth using
% tensor-field analysis; provides the geometric criterion that a
% sharp-feature-preserving fusion must respect.
% DOI verified via CrossRef (TVCG 2007, vol.13, no.1, pp.34-45).
@article{lai2007robust,
  author    = {Lai, Yu-kun and Zhou, Qian-yi and Hu, Shi-min and Wallner, Johannes and Pottmann, Helmut},
  title     = {Robust Feature Classification and Editing},
  journal   = {IEEE Transactions on Visualization and Computer Graphics},
  year      = {2007},
  volume    = {13},
  number    = {1},
  pages     = {34--45},
  doi       = {10.1109/tvcg.2007.19},
  note      = {Tensor-field-based sharp/smooth edge classification on meshes. Cited as ``Pauly et al. 2003 TVCG'' in some surveys but is actually Lai et al. 2007 TVCG — verify before citing.}
}

% The canonical oriented-point-cloud-to-watertight-mesh algorithm.
% Screened variant (below) is the implementation shipped in most tools,
% but this 2006 paper established the Poisson formulation.
% DOI verified via Eurographics Digital Library.
@inproceedings{kazhdan2006poisson,
  author    = {Kazhdan, Michael and Bolitho, Matthew and Hoppe, Hugues},
  title     = {Poisson Surface Reconstruction},
  booktitle = {Proceedings of the Eurographics Symposium on Geometry Processing (SGP 2006)},
  year      = {2006},
  pages     = {61--70},
  doi       = {10.2312/SGP/SGP06/061-070},
  note      = {Casts surface reconstruction as a spatial Poisson problem. Smoothness-biased: tends to round sharp corners unless screened variant is used. Open alternative to Artec Sharp Fusion for point-to-mesh step.}
}

% Extension with data-term screening; eliminates low-frequency bias near
% samples, recovering sharper detail than the original Poisson formulation.
% The version most likely used inside Artec Studio and open-source meshers.
% DOI verified via CrossRef (ACM TOG 32:3, 2013).
@article{kazhdan2013screened,
  author    = {Kazhdan, Michael and Hoppe, Hugues},
  title     = {Screened Poisson Surface Reconstruction},
  journal   = {ACM Transactions on Graphics},
  year      = {2013},
  volume    = {32},
  number    = {3},
  pages     = {1--13},
  doi       = {10.1145/2487228.2487237},
  note      = {Adds a screening term that pins the reconstructed function to the input points, substantially improving sharpness vs. the 2006 formulation. Standard open-source meshing backend (PoissonRecon executable).}
}

% Directional TSDF: addresses the fundamental aliasing problem of standard
% TSDF on thin structures by storing opposite-facing surfaces separately.
% Most directly relevant to depth-sensor fusion pipelines needing to preserve
% sharp convex/concave transitions, analogous to Artec Sharp Fusion's goal.
% DOI verified via CrossRef (IROS 2019, pp.1727-1734).
@inproceedings{splietker2019directional,
  author    = {Splietker, Malte and Behnke, Sven},
  title     = {Directional {TSDF}: Modeling Surface Orientation for Coherent Meshes},
  booktitle = {2019 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)},
  year      = {2019},
  pages     = {1727--1734},
  doi       = {10.1109/iros40897.2019.8968264},
  note      = {arXiv:1908.05146. Proposes a 6-directional TSDF that avoids surface merger at thin structures; open-source (github.com/AIS-Bonn/DirectionalTSDF). Closest open equivalent to Artec Sharp Fusion's handling of opposing surfaces.}
}

% Deep-learning framework for consolidating sharp feature points from raw
% (noisy, unorganised) point clouds via displacement learning. Bridges the
% gap between noisy acquisition and a clean sharp-feature skeleton.
% DOI verified via CrossRef (CAGD 103, 2023).
@article{zhao2023sharp,
  author    = {Zhao, Tong and Yu, Mulin and Alliez, Pierre and Lafarge, Florent},
  title     = {Sharp Feature Consolidation from Raw {3D} Point Clouds via Displacement Learning},
  journal   = {Computer Aided Geometric Design},
  year      = {2023},
  volume    = {103},
  pages     = {102204},
  doi       = {10.1016/j.cagd.2023.102204},
  note      = {Learning-based detection and snap-to-feature correction of sharp edges in noisy scans. Relevant pre-processing step before any volumetric fusion that is meant to preserve CAD-like edges.}
}

% Resampling and reconstruction that explicitly tracks and preserves
% feature curves (sharp edges) through the point-cloud processing pipeline.
% Addresses the loss of feature curves during decimation / re-meshing.
% DOI verified via CrossRef (CAD 167, 2024).
@article{fugacci2024reconstruction,
  author    = {Fugacci, Ulderico and Romanengo, Chiara and Falcidieno, Bianca and Biasotti, Silvia},
  title     = {Reconstruction and Preservation of Feature Curves in {3D} Point Cloud Processing},
  journal   = {Computer-Aided Design},
  year      = {2024},
  volume    = {167},
  pages     = {103649},
  doi       = {10.1016/j.cad.2023.103649},
  note      = {Surveys and addresses loss of feature curves during point cloud resampling; directly relevant to maintaining crease geometry through the ZED-capture-to-mesh pipeline.}
}

