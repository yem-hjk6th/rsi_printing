@article{patel2025normal,
  author    = {Patel, Aarya and Laga, Hamid and Sharma, Ojaswa},
  title     = {Normal-guided Detail-Preserving Neural Implicit Function for High-Fidelity {3D} Surface Reconstruction},
  journal   = {Proceedings of the ACM on Computer Graphics and Interactive Techniques},
  year      = {2025},
  volume    = {8},
  number    = {1},
  pages     = {1--24},
  doi       = {10.1145/3728293},
  note      = {arXiv:2406.04861. Trains neural implicit with surface-normal supervision; recovers sharp features from 2+ RGB views. State-of-the-art 2025 open alternative to proprietary detail-recovery steps.}
}

% -------------------------------------------------------
% SECTION C: Volumetric fusion pipelines (stereo pre-fusion context)
% -------------------------------------------------------

% Established dense multi-frame depth-image fusion via a truncated signed
% distance field (TSDF) updated incrementally. The foundational real-time
% dense reconstruction reference; all subsequent fusion pipelines
% (CHISEL, voxel hashing, Sharp Fusion) are architecturally derived from it.
% DOI verified via CrossRef (ISMAR 2011, pp.127-136).
@inproceedings{newcombe2011kinectfusion,
  author    = {Newcombe, Richard A. and Izadi, Shahram and Hilliges, Otmar and Molyneaux, David and Kim, David and Davison, Andrew J. and Kohli, Pushmeet and Shotton, Jamie and Hodges, Steve and Fitzgibbon, Andrew},
  title     = {{KinectFusion}: Real-time Dense Surface Mapping and Tracking},
  booktitle = {2011 10th IEEE International Symposium on Mixed and Augmented Reality (ISMAR)},
  year      = {2011},
  pages     = {127--136},
  doi       = {10.1109/ismar.2011.6092378},
  note      = {TSDF-based incremental dense reconstruction using a depth camera. Baseline for all real-time volumetric fusion; fixed-resolution voxel grid limits sharpness at fine scales.}
}

% DTAM: dense monocular (or stereo) reconstruction by sweeping cost volumes
% per keyframe and integrating depth maps. Predates KinectFusion in the
% dense photometric cost-volume formulation; relevant for stereo-to-depth
% pre-processing before volumetric fusion.
% DOI verified via CrossRef (ICCV 2011, pp.2320-2327).
@inproceedings{newcombe2011dtam,
  author    = {Newcombe, Richard A. and Lovegrove, Steven J. and Davison, Andrew J.},
  title     = {{DTAM}: Dense Tracking and Mapping in Real-Time},
  booktitle = {2011 International Conference on Computer Vision (ICCV)},
  year      = {2011},
  pages     = {2320--2327},
  doi       = {10.1109/iccv.2011.6126513},
  note      = {Dense photometric cost-volume reconstruction from a monocular or stereo camera; shows that fusing many frames before extracting depth dramatically improves surface completeness and reduces noise.}
}

% Spatially hashed TSDF enabling room-scale reconstruction without a
% fixed bounding box; practical precursor to OpenChisel / CHISEL.
% DOI verified via CrossRef (ACM TOG 32:6, SIGGRAPH Asia 2013).
@article{niessner2013voxelhashing,
  author    = {Nie{\ss}ner, Matthias and Zollh{\"o}fer, Michael and Izadi, Shahram and Stamminger, Marc},
  title     = {Real-time {3D} Reconstruction at Scale using Voxel Hashing},
  journal   = {ACM Transactions on Graphics},
  year      = {2013},
  volume    = {32},
  number    = {6},
  pages     = {1--11},
  doi       = {10.1145/2508363.2508374},
  note      = {SIGGRAPH Asia 2013. Hash-based spatial allocation of TSDF voxels scales to large scenes; enables dynamic resolution near surfaces, which can be exploited for sharper reconstruction near object boundaries.}
}

% CHISEL: TSDF reconstruction onboard a mobile device using spatially
% hashed SDF. Open-source (OpenChisel); lightweight anisotropy-aware
% fusion that is practically deployable in a stereo-camera pipeline.
% DOI verified via CrossRef (RSS XI 2015).
@inproceedings{klingensmith2015chisel,
  author    = {Klingensmith, Matthew and Dryanovski, Ivan and Srinivasa, Siddhartha and Xiao, Jizhong},
  title     = {Chisel: Real Time Large Scale {3D} Reconstruction Onboard a Mobile Device using Spatially Hashed Signed Distance Fields},
  booktitle = {Robotics: Science and Systems XI},
  year      = {2015},
  doi       = {10.15607/rss.2015.xi.040},
  note      = {RSS 2015 best-systems paper finalist. Open-source TSDF library (OpenChisel); reference implementation for lightweight SDF fusion applicable to stereo-depth pipelines.}
}

