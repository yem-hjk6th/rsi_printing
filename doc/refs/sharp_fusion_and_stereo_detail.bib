% SECTION D: Sub-pixel stereo / stereo evaluation
% -------------------------------------------------------

% Foundational taxonomy of stereo matching algorithms; defines the
% evaluation framework that all sub-pixel stereo papers measure against.
% The Middlebury benchmark originates from this work.
% DOI verified via CrossRef (IJCV 47:1-3, 2002).
@article{scharstein2002taxonomy,
  author    = {Scharstein, Daniel and Szeliski, Richard},
  title     = {A Taxonomy and Evaluation of Dense Two-Frame Stereo Correspondence Algorithms},
  journal   = {International Journal of Computer Vision},
  year      = {2002},
  volume    = {47},
  number    = {1--3},
  pages     = {7--42},
  doi       = {10.1023/a:1014573219977},
  note      = {Defines the Middlebury stereo evaluation methodology. Sub-pixel accuracy is among the metrics; establishes why sub-pixel disparity estimation matters for fine-geometry 3D reconstruction.}
}

% The 2014 Middlebury dataset: ground-truth sub-pixel-accurate disparities
% for high-resolution indoor scenes. The ground-truth benchmark against
% which any stereo pipeline targeting fine geometric detail should be tested.
% DOI verified via CrossRef (LNCS vol. Springer, GCPR 2014, pp.31-42).
@inproceedings{scharstein2014highres,
  author    = {Scharstein, Daniel and Hirschm{\"u}ller, Heiko and Kitajima, York and Krathwohl, Greg and Ne{\v{s}}i{\'c}, Nera and Wang, Xi and Westling, Porter},
  title     = {High-Resolution Stereo Datasets with Subpixel-Accurate Ground Truth},
  booktitle = {Pattern Recognition (GCPR 2014)},
  series    = {Lecture Notes in Computer Science},
  year      = {2014},
  pages     = {31--42},
  doi       = {10.1007/978-3-319-11752-2_3},
  note      = {Introduces Middlebury 2014 benchmark with sub-pixel ground truth. Defines the accuracy floor any stereo pipeline must reach to contribute meaningful fine-geometry depth for surface fusion.}
}

% Shows that sampling the disparity space at fractional steps, combined
% with a depth-discontinuity-preserving smoothing step, substantially
% reduces systematic sub-pixel error at large distances. Directly relevant
% to ZED stereo operating at 1-2 m working distance.
% DOI verified via CrossRef (CVIU 116:1, pp.16-24, 2012).
@article{gehrig2012subpixel,
  author    = {Gehrig, Stefan K. and Badino, Hern{\'a}n and Franke, Uwe},
  title     = {Improving Sub-Pixel Accuracy for Long Range Stereo},
  journal   = {Computer Vision and Image Understanding},
  year      = {2012},
  volume    = {116},
  number    = {1},
  pages     = {16--24},
  doi       = {10.1016/j.cviu.2011.07.008},
  note      = {Four improvements to sub-pixel stereo: fractional disparity sampling, discontinuity-preserving smoothing, weak stereo constraint, and multi-frame temporal averaging. Quantifies how sub-pixel accuracy degrades at range.}
}

% -------------------------------------------------------
% SECTION E: ZED-specific depth accuracy evaluation
% -------------------------------------------------------

% First peer-reviewed error model for the ZED stereo camera specifically.
% Fits RMS depth error as a function of distance and resolution; establishes
% that ZED accuracy degrades quadratically with range and is resolution-
% dependent. Key calibration reference for ZED-based RSI printing pipelines.
% DOI verified via CrossRef (ELCVIA 17:1, pp.1-15, 2018).
@article{ortiz2018zed,
  author    = {Ortiz, Luis Enrique and Cabrera, Viviana Elizabeth and Goncalves, Luiz M G},
  title     = {Depth Data Error Modeling of the {ZED} {3D} Vision Sensor from {Stereolabs}},
  journal   = {ELCVIA Electronic Letters on Computer Vision and Image Analysis},
  year      = {2018},
  volume    = {17},
  number    = {1},
  pages     = {1--15},
  doi       = {10.5565/rev/elcvia.1084},
  note      = {Mathematical error model for ZED at multiple resolutions. Shows best accuracy up to ~16 m; at 1-2 m the RMS error is centimetre-scale. Sets realistic expectations for ZED-based scanning.}
}

% Comprehensive evaluation of ZED 2i at indoor distances up to 18 m,
% across HD720/HD1080/HD2K resolutions. Finds depth error better modelled
% by a t-distribution than Gaussian; directly informs choice of working
% distance and resolution for stereo-based surface capture.
% DOI verified via CrossRef (Robotics and Autonomous Systems 179, 2024).
@article{abdelsalam2024zed2i,
  author    = {Abdelsalam, Ahmed and Mansour, Mostafa and Porras, Jari and Happonen, Ari},
  title     = {Depth Accuracy Analysis of the {ZED} 2i Stereo Camera in an Indoor Environment},
  journal   = {Robotics and Autonomous Systems},
  year      = {2024},
  volume    = {179},
  pages     = {104753},
  doi       = {10.1016/j.robot.2024.104753},
  note      = {Most complete ZED 2i evaluation to date. Shows depth error at 1-2 m is sub-centimetre for HD2K; t-distribution fit improves model accuracy. Directly applicable to RSI printing scan distance selection.}
}
