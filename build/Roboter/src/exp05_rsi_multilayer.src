DEF RSI_ML ( )

DECL INT ret
DECL INT CONTID
DECL INT I
DECL INT NUM_LINES
DECL REAL X_CUR
DECL E6POS TARGET
DECL BOOL DIR_FWD

BAS (#INITMOV,0 )
BAS(#TOOL, 3)
BAS(#BASE, 0)
BAS(#VEL_PTP, 10)
PDAT_ACT.ACC = 50
PDAT_ACT.APO_DIST = 50
$BWDSTART = TRUE
$VEL.CP=0.2
$ADVANCE=3

PTP  {A1 5,A2 -90,A3 100,A4 5,A5 -10,A6 -5,E1 0,E2 0,E3 0,E4 0}

PelletExtruderRPM = 150

ret = RSI_CREATE("RSI_MIN.rsi", CONTID, TRUE)
IF (ret <> RSIOK) THEN
    HALT
ENDIF

ret = RSI_ON(#RELATIVE)
IF (ret <> RSIOK) THEN
    HALT
ENDIF

NUM_LINES = 36
X_CUR = 900
DIR_FWD = TRUE
TARGET = {X 900, Y 315, Z 21, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0}

PTP {X 900, Y 315, Z 60, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0, S 'B110'} C_PTP
LIN {X 900, Y 315, Z 25, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0}
$VEL.CP=0.01
LIN {X 900, Y 315, Z 21, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} C_DIS

FOR I = 1 TO NUM_LINES

    TARGET.X = X_CUR
    IF (DIR_FWD) THEN
        TARGET.Y = -285
    ELSE
        TARGET.Y = 315
    ENDIF
    LIN TARGET C_DIS
    DIR_FWD = NOT DIR_FWD

    IF (I < NUM_LINES) THEN
        X_CUR = X_CUR - 10
        TARGET.X = X_CUR
        LIN TARGET C_DIS
    ENDIF

ENDFOR

ret = RSI_OFF()

END
