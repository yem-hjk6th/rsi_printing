DEF aut_cam_far( )

DECL INT ret
DECL INT CONTID

BAS (#INITMOV,0 )
BAS(#TOOL, 3)
BAS(#BASE, 0)
BAS(#VEL_PTP, 10)
PDAT_ACT.ACC = 50
PDAT_ACT.APO_DIST = 50
$BWDSTART = TRUE
$ADVANCE = 1
$VEL.CP = 0.08
$APO.CDIS = 2.0

PTP {A1 5,A2 -90,A3 100,A4 5,A5 -10,A6 -5,E1 0,E2 0,E3 0,E4 0}

ret = RSI_CREATE("RSI_MIN.rsi", CONTID, TRUE)
IF (ret <> RSIOK) THEN
  HALT
ENDIF

ret = RSI_ON(#RELATIVE)
IF (ret <> RSIOK) THEN
  HALT
ENDIF

PTP {X 860, Y  40, Z 480, A   0, B  90, C   0, E1 0, E2 0, E3 0, E4 0, S 'B110'}
WAIT SEC 3.00

LIN {X 860, Y  40, Z 440, A   0, B  90, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 860, Y  40, Z 440, A -24, B  90, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 860, Y  40, Z 440, A  24, B  90, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 860, Y  40, Z 440, A   0, B 100, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 860, Y  40, Z 440, A   0, B  80, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 860, Y  40, Z 440, A -20, B  98, C  14, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 860, Y  40, Z 440, A  20, B  82, C -14, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 940, Y 180, Z 430, A -18, B  94, C  -8, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 940, Y -180,Z 430, A  18, B  86, C   8, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 760, Y 220, Z 420, A -16, B  96, C -12, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 760, Y -220,Z 420, A  16, B  84, C  12, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 980, Y  40, Z 410, A -12, B 100, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 700, Y  40, Z 410, A  12, B  80, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 900, Y 260, Z 390, A -18, B  94, C -14, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 900, Y -260,Z 390, A  18, B  86, C  14, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 820, Y  40, Z 370, A -10, B  98, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 820, Y  40, Z 460, A  10, B  82, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 860, Y  40, Z 440, A   0, B  90, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 1.00

ret = RSI_OFF()
IF (ret <> RSIOK) THEN
  HALT
ENDIF

PTP {A1 5,A2 -90,A3 100,A4 5,A5 -10,A6 -5,E1 0,E2 0,E3 0,E4 0}

END
