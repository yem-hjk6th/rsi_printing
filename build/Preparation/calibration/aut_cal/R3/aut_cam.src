DEF aut_cam( )

DECL INT ret
DECL INT CONTID

BAS (#INITMOV,0 )
BAS(#TOOL, 3)
BAS(#BASE, 0)
BAS(#VEL_PTP, 10)
PDAT_ACT.ACC = 50
PDAT_ACT.APO_DIST = 50
$BWDSTART = TRUE
$ADVANCE = 1
$VEL.CP = 0.08
$APO.CDIS = 2.0

PTP {A1 5,A2 -90,A3 100,A4 5,A5 -10,A6 -5,E1 0,E2 0,E3 0,E4 0}

ret = RSI_CREATE("RSI_MIN.rsi", CONTID, TRUE)
IF (ret <> RSIOK) THEN
  HALT
ENDIF

ret = RSI_ON(#RELATIVE)
IF (ret <> RSIOK) THEN
  HALT
ENDIF

PTP {X 840, Y  40, Z 460, A   0, B  90, C   0, E1 0, E2 0, E3 0, E4 0, S 'B110'}
WAIT SEC 3.00

LIN {X 840, Y  40, Z 430, A   0, B  90, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 840, Y  40, Z 430, A -18, B  90, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 840, Y  40, Z 430, A  18, B  90, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 840, Y  40, Z 430, A   0, B  96, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 840, Y  40, Z 430, A   0, B  84, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 840, Y  40, Z 430, A -14, B  94, C   9, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 840, Y  40, Z 430, A  14, B  86, C  -9, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 900, Y 140, Z 410, A -12, B  90, C  -6, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 900, Y -140,Z 410, A  12, B  90, C   6, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 760, Y 160, Z 400, A -10, B  92, C  -8, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 760, Y -160,Z 400, A  10, B  88, C   8, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 920, Y  40, Z 390, A  -8, B  94, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 700, Y  40, Z 390, A   8, B  86, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 840, Y 200, Z 380, A -12, B  92, C -10, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 840, Y -200,Z 380, A  12, B  88, C  10, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 840, Y  40, Z 430, A   0, B  90, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 1.00

ret = RSI_OFF()
IF (ret <> RSIOK) THEN
  HALT
ENDIF

PTP {A1 5,A2 -90,A3 100,A4 5,A5 -10,A6 -5,E1 0,E2 0,E3 0,E4 0}

END
