DEF exp04_rsi_capture_safepts ( )

DECL INT ret
DECL INT CONTID
DECL INT i

BAS (#INITMOV,0 )
BAS(#TOOL, 3)
BAS(#BASE, 0)
BAS(#VEL_PTP, 10)
PDAT_ACT.ACC = 50
PDAT_ACT.APO_DIST = 50
$BWDSTART = TRUE
$ADVANCE = 1
$VEL.CP = 0.10
$APO.CDIS = 2.0

PTP {A1 5,A2 -90,A3 100,A4 5,A5 -10,A6 -5,E1 0,E2 0,E3 0,E4 0}

ret = RSI_CREATE("RSI_MIN.rsi", CONTID, TRUE)
IF (ret <> RSIOK) THEN
  HALT
ENDIF

ret = RSI_ON(#RELATIVE)
IF (ret <> RSIOK) THEN
  HALT
ENDIF

PTP {X 760, Y  40, Z 420, A   0, B 90, C   0, E1 0, E2 0, E3 0, E4 0, S 'B110'}
WAIT SEC 3.00

LIN {X 760, Y  40, Z 300, A   0, B 90, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 700, Y 300, Z 360, A -12, B 88, C -10, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 700, Y -240,Z 360, A  12, B 88, C  10, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 900, Y  40, Z 340, A  -8, B 85, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 620, Y  40, Z 340, A   8, B 85, C   0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 840, Y 220, Z 320, A -15, B 82, C -12, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 840, Y -220,Z 320, A  15, B 82, C  12, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 3.00

LIN {X 760, Y 40,  Z 420, A 0, B 90, C 0, E1 0, E2 0, E3 0, E4 0}
WAIT SEC 1.00

ret = RSI_OFF()
IF (ret <> RSIOK) THEN
  HALT
ENDIF

PTP {A1 5,A2 -90,A3 100,A4 5,A5 -10,A6 -5,E1 0,E2 0,E3 0,E4 0}

END
