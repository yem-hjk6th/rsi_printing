DEF RSI_4pt ( )

;VARIABLE DECLARATIONS
DECL INT ret
DECL INT CONTID

;FOLD INI
BAS (#INITMOV,0 )
;BASE IS 0, TOOL IS 3, FIXED START POS
BAS(#TOOL, 3)
BAS(#BASE, 0)
BAS(#VEL_PTP, 10)
PDAT_ACT.ACC = 50
PDAT_ACT.APO_DIST = 50
$BWDSTART = TRUE
$VEL.CP=0.2
$ADVANCE=3
;ENDFOLD (INI)

PTP  {A1 5,A2 -90,A3 100,A4 5,A5 -10,A6 -5,E1 0,E2 0,E3 0,E4 0}

;EXTRUDER RPM
PelletExtruderRPM = 150

;RSI INI
ret = RSI_CREATE("RSI_MIN.rsi", CONTID, TRUE)
IF (ret <> RSIOK) THEN
    HALT
ENDIF

ret = RSI_ON(#RELATIVE)
IF (ret <> RSIOK) THEN
    HALT
ENDIF

;MAIN
PTP {X 900, Y 315, Z 60, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0, S 'B110'} C_PTP
LIN {X 900, Y 315, Z 25, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} 
$VEL.CP=0.01
LIN {X 900, Y 315, Z 21, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} C_DIS
LIN {X 900, Y -285, Z 20, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} C_DIS
LIN {X 550, Y -285, Z 17, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} C_DIS
LIN {X 550, Y 315, Z 18, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} C_DIS
LIN {X 900, Y 315, Z 22, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} C_DIS

ret = RSI_OFF()

END
